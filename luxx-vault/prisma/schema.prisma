// Luxx4less database schema.
// Auth tables (user, session, account, verification, twoFactor, passkey,
// rateLimit) match Better Auth's plugins; generate them with the Better Auth
// CLI rather than editing by hand. App tables follow at the bottom.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                    @id
  name             String
  email            String
  emailVerified    Boolean                   @default(false)
  image            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  twoFactorEnabled Boolean?                  @default(false)
  /// Comma-separated roles: buyer, seller, reseller, support, kyc_reviewer, admin, super_admin
  role             String?                   @default("buyer")
  banned           Boolean?                  @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  passkeys         Passkey[]
  consents         ConsentRecord[]
  auditLogs        AuditLog[]                @relation("actor")
  profile          Profile?
  phoneOtps        PhoneOtp[]
  kycSubmissions   KycSubmission[]           @relation("kycApplicant")
  kycReviews       KycSubmission[]           @relation("kycReviewer")
  listings         Listing[]
  buyRequests      BuyRequest[]
  offersSent       Offer[]                   @relation("offerFrom")
  offersReceived   Offer[]                   @relation("offerTo")
  participations   ConversationParticipant[]
  messages         Message[]
  purchases        Trade[]                   @relation("tradeBuyer")
  sales            Trade[]                   @relation("tradeSeller")
  reviewsWritten   Review[]                  @relation("reviewAuthor")
  reviewsReceived  Review[]                  @relation("reviewSubject")
  reports          Report[]
  disputes         Dispute[]
  savedListings    SavedListing[]
  priceAlerts      PriceAlert[]
  channels         NotificationChannel[]
  notifications    Notification[]
  media            MediaObject[]
  sellQuotes       SellQuote[]
  faceChecks       FaceCheck[]
  cartItems        CartItem[]
  shopOrders       ShopOrder[]
  feePayments      FeePayment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------------------------------------------------------------- app tables

/// What a person agreed to, when, and from where (Data Privacy Act evidence).
/// Rows are never updated: a withdrawal is a new row with granted = false.
model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// terms | privacy | age_18 | marketing | kyc_biometrics (Phase 5)
  kind      String
  /// Version of the policy text agreed to, e.g. "2026-09-30".
  version   String
  granted   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@map("consent_record")
}

/// Append-only log of security, admin and money-related actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  /// Never store secrets, tokens or full ID numbers here.
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

/// Emails captured by the mock email provider (development and demos only).
model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@map("dev_email")
}

// ============================================================ profiles & verification

/// Public-facing profile and verification state. One per user, created at onboarding.
model Profile {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Public showroom address: /sellers/{handle}. Lowercase letters, digits, dots, hyphens.
  handle             String    @unique
  displayName        String
  bio                String?
  /// E.164, e.g. +639171234567. Shown only to staff, never publicly.
  phone              String?
  phoneVerifiedAt    DateTime?
  regionCode         String?
  provinceCode       String?
  cityCode           String?
  businessName       String?
  specializations    String[]  @default([])
  tools              String[]  @default([])
  /// Lower bound of the chosen EXPERIENCE bucket (config/catalog.ts).
  yearsExperience    Int?
  /// Tier 3: government ID + liveness + face match approved.
  identityVerifiedAt DateTime?
  /// Tier 4: proof of address + payout account in own name approved.
  sellerVerifiedAt   DateTime?
  /// Set after three failed face checks in a row; trading pauses until staff lift it.
  faceLockedAt       DateTime?
  /// Seller showroom extras.
  showroomTagline    String?
  coverMediaId       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([regionCode, cityCode])
  @@map("profile")
}

/// SMS one-time codes (Tier 2). Only a hash of the code is stored.
model PhoneOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("phone_otp")
}

/// An identity (Tier 3) or seller (Tier 4) verification attempt.
/// ID images are never stored here: the provider holds them. Numbers are masked.
model KycSubmission {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("kycApplicant", fields: [userId], references: [id], onDelete: Cascade)
  /// identity | seller
  level            String
  /// Key from config/kyc.ts, e.g. philsys, passport, drivers_license.
  idType           String?
  /// Last four characters only, for masked display.
  idNumberLast4    String?
  nameOnId         String?
  birthYear        Int?
  idExpiry         DateTime?
  /// Seller level: proof-of-address kind, business registration kind, payout account (masked).
  addressProofKind String?
  businessRegKind  String?
  payoutMasked     String?
  /// mock | sumsub | veriff | persona
  provider         String
  providerRef      String?
  /// 0..1 scores reported by the provider.
  livenessScore    Float?
  faceMatchScore   Float?
  /// Provider or rule flags: expired_id, name_mismatch, underage, duplicate_face, duplicate_id
  flags            String[]  @default([])
  /// pending | approved | needs_resubmission | rejected
  status           String    @default("pending")
  decisionReason   String?
  reviewerId       String?
  reviewer         User?     @relation("kycReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, level])
  @@map("kyc_submission")
}

// ============================================================ prices

/// One observation from the price engine. At most one per metal per minute.
model PriceSnapshot {
  id         String   @id @default(cuid())
  /// gold | silver | platinum | palladium
  metal      String
  usdPerOz   Decimal  @db.Decimal(12, 4)
  usdPhp     Decimal  @db.Decimal(10, 4)
  /// Pure metal, PHP per gram.
  phpPerGram Decimal  @db.Decimal(12, 4)
  source     String
  fxSource   String
  /// When the source says the price was set.
  observedAt DateTime
  createdAt  DateTime @default(now())

  @@index([metal, createdAt])
  @@map("price_snapshot")
}

/// Daily closing price per metal, for charts and the performance table.
/// Filled from our own snapshots and, when GOLD_API_KEY is set, backfilled from gold-api.com.
model PriceDaily {
  metal      String
  day        DateTime @db.Date
  usdPerOz   Decimal  @db.Decimal(12, 4)
  usdPhp     Decimal? @db.Decimal(10, 4)
  phpPerGram Decimal? @db.Decimal(12, 4)
  source     String

  @@id([metal, day])
  @@map("price_daily")
}

/// Luxx4less buy/sell spreads ("We buy at" / "We sell at") as a ratio of melt value.
model Spread {
  id          String   @id @default(cuid())
  metal       String   @default("gold")
  /// Karat for gold, fineness (e.g. 925) for other metals.
  purity      Int
  /// jewelry | bullion
  productType String   @default("jewelry")
  /// 0.92 = we buy at 92% of melt value.
  buyRatio    Decimal  @db.Decimal(6, 4)
  /// 1.18 = we sell at 118% of melt value.
  sellRatio   Decimal  @db.Decimal(6, 4)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([metal, purity, productType])
  @@map("spread")
}

/// "Tell me when 18K goes below PHP X per gram."
model PriceAlert {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metal            String
  /// Gold karat, or null for pure metal.
  karat            Int?
  /// above | below
  direction        String
  targetPhpPerGram Decimal   @db.Decimal(12, 2)
  /// email | viber | messenger | in_app
  channels         String[]  @default(["email", "in_app"])
  active           Boolean   @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime  @default(now())

  @@index([active, metal])
  @@index([userId])
  @@map("price_alert")
}

// ============================================================ media

/// Uploaded images, re-encoded to WebP with metadata stripped.
/// Stored in the database by default; lib/server/media can move them to a blob store later.
model MediaObject {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// listing | showroom_cover | dispute_evidence | product | payment_proof
  purpose   String
  mime      String
  bytes     Bytes?
  /// Set when stored externally instead of in `bytes`.
  url       String?
  width     Int
  height    Int
  sha256    String
  /// 64-bit difference hash as 16 hex characters, for stolen-photo detection.
  phash     String
  createdAt DateTime @default(now())

  @@index([phash])
  @@index([ownerId, createdAt])
  @@map("media_object")
}

// ============================================================ marketplace

/// A verified seller's item for sale.
model Listing {
  id               String         @id @default(cuid())
  /// Short public number shown on watermarks and in chats, e.g. LX-4F7K2.
  code             String         @unique
  sellerId         String
  seller           User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title            String
  category         String
  metal            String?
  karat            Int?
  /// Parts per thousand (916, 750, 925).
  finenessPermille Int?
  goldType         String?
  form             String?
  weightGrams      Decimal        @db.Decimal(10, 3)
  /// fixed | spot_premium
  pricingMode      String         @default("fixed")
  pricePhp         Decimal?       @db.Decimal(14, 2)
  /// spot_premium: price = melt value x (1 + premiumPct / 100).
  premiumPct       Decimal?       @db.Decimal(6, 2)
  openToOffers     Boolean        @default(false)
  description      String
  hasCertificate   Boolean        @default(false)
  hasReceipt       Boolean        @default(false)
  pawnable         Boolean?
  regionCode       String
  provinceCode     String?
  cityCode         String
  /// draft | active | reserved | sold | expired | removed
  status           String         @default("active")
  /// Owner-of-items declaration at listing time.
  declaredOwnerAt  DateTime
  luxxTestedAt     DateTime?
  luxxTestResult   String?
  views            Int            @default(0)
  reportCount      Int            @default(0)
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ListingImage[]
  offers           Offer[]
  conversations    Conversation[]
  trades           Trade[]
  saved            SavedListing[]

  @@index([status, category, createdAt])
  @@index([sellerId, status])
  @@index([regionCode, cityCode])
  @@map("listing")
}

model ListingImage {
  id                   String  @id @default(cuid())
  listingId            String
  listing              Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mediaId              String
  position             Int     @default(0)
  /// Set when the photo's perceptual hash matches another seller's photo.
  duplicateOfListingId String?

  @@index([listingId, position])
  @@map("listing_image")
}

/// A buyer's wanted post (the reference calls these bids or buying offers).
model BuyRequest {
  id            String         @id @default(cuid())
  code          String         @unique
  buyerId       String
  buyer         User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  title         String
  category      String
  metal         String?
  karat         Int?
  goldType      String?
  form          String?
  minGrams      Decimal?       @db.Decimal(10, 3)
  maxGrams      Decimal?       @db.Decimal(10, 3)
  budgetMaxPhp  Decimal?       @db.Decimal(14, 2)
  description   String
  regionCode    String
  provinceCode  String?
  cityCode      String?
  /// open | fulfilled | closed | expired | removed
  status        String         @default("open")
  reportCount   Int            @default(0)
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  offers        Offer[]
  conversations Conversation[]
  trades        Trade[]

  @@index([status, category, createdAt])
  @@index([buyerId, status])
  @@map("buy_request")
}

/// An offer on a listing (buyer to seller) or on a wanted post (seller to buyer).
model Offer {
  id           String      @id @default(cuid())
  listingId    String?
  listing      Listing?    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyRequestId String?
  buyRequest   BuyRequest? @relation(fields: [buyRequestId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User        @relation("offerFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User        @relation("offerTo", fields: [toUserId], references: [id], onDelete: Cascade)
  amountPhp    Decimal     @db.Decimal(14, 2)
  weightGrams  Decimal?    @db.Decimal(10, 3)
  message      String?
  /// pending | accepted | declined | withdrawn | countered | expired
  status       String      @default("pending")
  counterOfId  String?
  expiresAt    DateTime
  respondedAt  DateTime?
  createdAt    DateTime    @default(now())
  trade        Trade?

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("offer")
}

model Conversation {
  id            String                    @id @default(cuid())
  listingId     String?
  listing       Listing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyRequestId  String?
  buyRequest    BuyRequest?               @relation(fields: [buyRequestId], references: [id], onDelete: SetNull)
  tradeId       String?                   @unique
  trade         Trade?                    @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversation")
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  blockedAt      DateTime?

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participant")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// user | system
  kind           String       @default("user")
  body           String
  /// Anti-scam detector hits: phone_number, bank_account, off_platform_payment, external_link, pressure
  flags          String[]     @default([])
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

/// A deal between two verified users. Money is held by a payment provider, never by Luxx4less.
model Trade {
  id              String        @id @default(cuid())
  code            String        @unique
  listingId       String?
  listing         Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyRequestId    String?
  buyRequest      BuyRequest?   @relation(fields: [buyRequestId], references: [id], onDelete: SetNull)
  offerId         String?       @unique
  offer           Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  buyerId         String
  buyer           User          @relation("tradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId        String
  seller          User          @relation("tradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  amountPhp       Decimal       @db.Decimal(14, 2)
  /// Snapshot of what was traded, for the anonymised trade tape.
  category        String
  metal           String?
  karat           Int?
  goldType        String?
  form            String?
  weightGrams     Decimal       @db.Decimal(10, 3)
  regionCode      String
  cityCode        String?
  /// shipping | meetup | luxx_meetup
  fulfilment      String        @default("shipping")
  trackingNumber  String?
  courier         String?
  /// awaiting_payment | payment_held | shipped | received | released | disputed | refunded | cancelled
  status          String        @default("awaiting_payment")
  /// mock | paymongo | xendit
  paymentProvider String        @default("mock")
  paymentRef      String?
  /// Released automatically after this date if no dispute is open.
  autoReleaseAt   DateTime?
  releasedAt      DateTime?
  /// Either side can keep a completed trade off the public trade tape.
  hideFromTape    Boolean       @default(false)
  /// Luxx4less commission, charged to the seller when the trade completes (listing is free).
  feePct          Decimal?      @db.Decimal(5, 2)
  feePhp          Decimal?      @db.Decimal(14, 2)
  feeDueAt        DateTime?
  feePaidAt       DateTime?
  /// Staff waived it (with a reason in the audit log).
  feeWaivedAt     DateTime?
  feeRemindedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation?
  reviews         Review[]
  disputes        Dispute[]

  @@index([status, releasedAt])
  @@index([buyerId])
  @@index([sellerId])
  @@index([sellerId, feePaidAt])
  @@map("trade")
}

model Review {
  id        String   @id @default(cuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("reviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User     @relation("reviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  createdAt DateTime @default(now())

  @@unique([tradeId, authorId])
  @@index([subjectId, createdAt])
  @@map("review")
}

model Dispute {
  id               String    @id @default(cuid())
  tradeId          String
  trade            Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  openedById       String
  openedBy         User      @relation(fields: [openedById], references: [id], onDelete: Cascade)
  reason           String
  details          String
  evidenceMediaIds String[]  @default([])
  /// open | resolved_buyer | resolved_seller | withdrawn
  status           String    @default("open")
  resolution       String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@map("dispute")
}

model Report {
  id          String    @id @default(cuid())
  reporterId  String
  reporter    User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  /// user | listing | buy_request | message | outside_number
  targetType  String
  targetId    String
  reason      String
  details     String?
  /// open | actioned | dismissed
  status      String    @default("open")
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("report")
}

model SavedListing {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@map("saved_listing")
}

/// Sell to Luxx4less: an instant estimate turned into a quote request or appraisal booking.
model SellQuote {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  contact          String
  metal            String
  karat            Int?
  finenessPermille Int?
  weightGrams      Decimal   @db.Decimal(10, 3)
  estimatePhp      Decimal   @db.Decimal(14, 2)
  /// antipolo | ongpin | online
  branch           String
  preferredDate    DateTime?
  notes            String?
  /// new | contacted | booked | bought | closed
  status           String    @default("new")
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@map("sell_quote")
}

// ============================================================ notifications

/// A Viber or Messenger account linked to a user, for alerts outside email.
model NotificationChannel {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// viber | messenger
  kind       String
  /// The platform's id for this person (Viber user id, Messenger PSID). Null until linked.
  externalId String?
  /// One-time code carried in the deep link, matched by the webhook.
  linkCode   String?   @unique
  linkedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, kind])
  @@map("notification_channel")
}

/// In-app notification feed (bell icon), also the record of where each one was delivered.
model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// offer_received | offer_accepted | message | trade_update | price_alert | kyc_update | review
  kind         String
  title        String
  body         String
  href         String?
  /// Channels actually delivered: in_app, email, viber, messenger
  deliveredVia String[]  @default([])
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// What the mock Viber and Messenger adapters would have sent (like dev_email).
model DevOutbox {
  id        String   @id @default(cuid())
  channel   String
  to        String
  text      String
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@map("dev_outbox")
}

/// A face re-verification for an ID-verified person (owner, 1 Oct 2026): before trading on a new
/// sign-in, before high-value trades and before payout changes. Tied to the session it was done in.
/// No images are stored here; a live vendor keeps the capture in its own vault.
model FaceCheck {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Better Auth session id: a check on one device or sign-in never counts for another.
  sessionId      String?
  /// session | high_value | account_change
  purpose        String
  /// mock | sumsub | veriff | persona | rekognition
  provider       String
  providerRef    String?
  passed         Boolean
  livenessScore  Float?
  faceMatchScore Float?
  flags          String[] @default([])
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("face_check")
}

// ============================================================ official shop

/// Something Luxx4less sells itself (the Official Shop, brief §9). Added and edited by admins
/// in /admin/shop. No seller limits apply: this is the shop's own stock.
model Product {
  id               String          @id @default(cuid())
  /// Short public number shown on watermarks and orders, e.g. LP-4F7K2.
  code             String          @unique
  title            String
  category         String
  metal            String?
  karat            Int?
  /// Parts per thousand (916, 750, 925).
  finenessPermille Int?
  goldType         String?
  form             String?
  weightGrams      Decimal         @db.Decimal(10, 3)
  /// fixed | spot_premium
  pricingMode      String          @default("fixed")
  pricePhp         Decimal?        @db.Decimal(14, 2)
  /// spot_premium: price = melt value x (1 + premiumPct / 100), locked when an order is placed.
  premiumPct       Decimal?        @db.Decimal(6, 2)
  description      String
  hasCertificate   Boolean         @default(false)
  pawnable         Boolean?
  /// Pieces on hand. Placing an order holds them; a cancelled order puts them back.
  stock            Int             @default(1)
  layawayAllowed   Boolean         @default(true)
  /// Shown first in the shop and on the home page.
  featured         Boolean         @default(false)
  /// draft | active | archived. Sold out is simply stock = 0.
  status           String          @default("draft")
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       ShopOrderItem[]

  @@index([status, featured, createdAt])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  position  Int     @default(0)

  @@index([productId, position])
  @@index([mediaId])
  @@map("product_image")
}

/// The shopping bag (Tier 1). Prices are never stored here: they are worked out live.
model CartItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@map("cart_item")
}

/// An Official Shop order. Prices are locked when it is placed.
model ShopOrder {
  id             String            @id @default(cuid())
  /// Short public number, e.g. OR-4F7K2.
  code           String            @unique
  buyerId        String
  buyer          User              @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  /// pending_payment | payment_review | awaiting_confirmation | layaway | preparing | ready | shipped | completed | cancelled
  status         String            @default("pending_payment")
  /// full | layaway
  plan           String            @default("full")
  /// in_store | transfer | cod
  paymentMethod  String
  /// pickup | delivery | meetup
  fulfilment     String
  /// Pickup branch name (brand.branches).
  branch         String?
  contactName    String
  /// E.164. Shown to the buyer and staff only.
  contactPhone   String
  addressLine    String?
  regionCode     String?
  provinceCode   String?
  cityCode       String?
  buyerNote      String?
  subtotalPhp    Decimal           @db.Decimal(14, 2)
  deliveryFeePhp Decimal           @default(0) @db.Decimal(14, 2)
  totalPhp       Decimal           @db.Decimal(14, 2)
  /// Sum of confirmed payments.
  paidPhp        Decimal           @default(0) @db.Decimal(14, 2)
  /// Layaway: what must be paid first to reserve the items.
  downPaymentPhp Decimal?          @db.Decimal(14, 2)
  /// An order with nothing paid is cancelled after this and its items go back on sale.
  payBy          DateTime?
  courier        String?
  trackingNumber String?
  cancelReason   String?
  cancelledAt    DateTime?
  paidAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          ShopOrderItem[]
  payments       ShopPayment[]
  installments   ShopInstallment[]

  @@index([status, createdAt])
  @@index([buyerId, createdAt])
  @@map("shop_order")
}

/// What was bought, as it was when ordered (the product may change or be archived later).
model ShopOrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  code         String
  title        String
  metal        String?
  karat        Int?
  weightGrams  Decimal   @db.Decimal(10, 3)
  quantity     Int
  unitPricePhp Decimal   @db.Decimal(14, 2)
  coverMediaId String?

  @@index([orderId])
  @@map("shop_order_item")
}

/// A payment toward an order: a receipt the buyer uploaded (GCash or bank transfer), or one
/// staff recorded (cash in store, cash on delivery). Only confirmed payments count.
model ShopPayment {
  id            String    @id @default(cuid())
  orderId       String
  order         ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// transfer | in_store | cod
  method        String
  amountPhp     Decimal   @db.Decimal(14, 2)
  /// The GCash or bank reference number the buyer typed.
  reference     String?
  proofMediaId  String?
  /// submitted | confirmed | rejected
  status        String    @default("submitted")
  submittedById String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime  @default(now())

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("shop_payment")
}

/// Layaway (hulugan) schedule: the down payment is seq 0, then monthly payments.
model ShopInstallment {
  id         String    @id @default(cuid())
  orderId    String
  order      ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seq        Int
  dueAt      DateTime
  amountPhp  Decimal   @db.Decimal(14, 2)
  paidAt     DateTime?
  remindedAt DateTime?

  @@unique([orderId, seq])
  @@index([paidAt, dueAt])
  @@map("shop_installment")
}

/// The Official Shop's settings, one row, edited by admins in /admin/shop/settings.
/// Payment details live here and never in code (brief: no account numbers in the UI). They are
/// shown only to a buyer on their own order page, after the order is placed.
model ShopSettings {
  id                  String   @id @default("shop")
  paymentInstructions String?
  /// Days an unpaid order holds its items.
  reserveDays         Int      @default(3)
  layawayEnabled      Boolean  @default(true)
  layawayDownPct      Int      @default(30)
  layawayMonths       Int      @default(3)
  layawayMinPhp       Decimal  @default(5000) @db.Decimal(14, 2)
  codEnabled          Boolean  @default(true)
  /// Cash on delivery only up to this total. Null = no limit.
  codMaxPhp           Decimal? @db.Decimal(14, 2)
  /// Null = quoted after ordering, not added to the total.
  deliveryFeePhp      Decimal? @db.Decimal(14, 2)
  updatedById         String?
  updatedAt           DateTime @updatedAt

  @@map("shop_settings")
}

// ============================================================ marketplace fees

/// A seller paying their Luxx4less fees: a GCash or bank receipt they uploaded, or a payment staff
/// recorded. Confirmed payments settle the oldest unpaid fees first.
model FeePayment {
  id           String    @id @default(cuid())
  sellerId     String
  seller       User      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  amountPhp    Decimal   @db.Decimal(14, 2)
  /// transfer | in_store
  method       String    @default("transfer")
  reference    String?
  proofMediaId String?
  /// submitted | confirmed | rejected
  status       String    @default("submitted")
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("fee_payment")
}

/// Marketplace fee settings, one row, edited by admins in /admin/fees. Changes apply to trades
/// completed afterwards; each trade keeps the rate it was charged at.
model MarketSettings {
  id          String   @id @default("market")
  /// Commission on each completed trade, paid by the seller.
  feePct      Decimal  @default(3) @db.Decimal(5, 2)
  feeMinPhp   Decimal? @db.Decimal(14, 2)
  feeMaxPhp   Decimal? @db.Decimal(14, 2)
  /// Days a seller has to pay a fee before their new selling pauses.
  feePayDays  Int      @default(7)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("market_settings")
}
