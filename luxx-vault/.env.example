# Luxx4less environment variables. Copy to .env for local development.
# On Vercel: Project → Settings → Environment Variables.

# --- Database (PostgreSQL) -----------------------------------------------
# Local: postgresql://USER:PASSWORD@localhost:5432/luxx4less_dev
# Vercel + Neon: added automatically when you connect a Neon database
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct, used for migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Sign-in ----------------------------------------------------------------
# A long random secret (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never reuse the local one in production.
BETTER_AUTH_SECRET=
# The site's public address. On Vercel this defaults to the production domain;
# set it once you use your own domain (e.g. https://luxx4less.ph).
BETTER_AUTH_URL=
# Passkeys are tied to this domain (bare host, no https://). Defaults to the host of BETTER_AUTH_URL.
PASSKEY_RP_ID=
# Breached-password check (haveibeenpwned.com, k-anonymity). Keep "on" in production.
HIBP_CHECK=on

# --- Email ----------------------------------------------------------------------
# "resend" or "smtp" send real email; "mock" stores it in the on-site test mailbox (/dev/mailbox).
EMAIL_PROVIDER=mock
# From address; the domain must be verified in Resend.
EMAIL_FROM="Luxx4less <no-reply@luxx4less.ph>"
RESEND_API_KEY=
# "smtp": send through any SMTP account. Defaults suit Gmail (smtp.gmail.com:465).
# For Gmail, EMAIL_FROM must be the Gmail address, and SMTP_PASSWORD is an app password
# (Google Account > Security > 2-Step Verification on > App passwords), never the real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Only for a public demo before Resend is set up: allows mock email in production.
# The mailbox then needs ?key=MAILBOX_KEY (16+ random characters) because it shows sign-in links.
ALLOW_MOCK_EMAIL_IN_PRODUCTION=false
MAILBOX_KEY=

# --- Prices ---------------------------------------------------------------------
# Live spot prices come from gold-api.com (no key) and USD/PHP from open.er-api.com and
# frankfurter.dev (no keys). These are optional:
# gold-api.com key (free account): backfills 20 years of daily history for the charts.
GOLD_API_KEY=
# metals.dev key: a second spot source used only when gold-api.com fails.
METALS_DEV_API_KEY=
# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"). 16+ random characters.
CRON_SECRET=

# --- Verification ---------------------------------------------------------------
# SMS codes for mobile verification: "mock" shows the code on screen (test mode) and
# stores it in /dev/outbox; "semaphore" sends a real SMS via semaphore.co (paid, about
# PHP 1 per code); "smsgate" sends from the shop's own Android phone and SIM through the
# free SMSGate app (sms-gate.app): no per-message fee, but the phone must stay on and online.
SMS_PROVIDER=mock
SEMAPHORE_API_KEY=
# Up to 11 characters, registered with Semaphore.
SEMAPHORE_SENDER_NAME=
# Shown in the SMSGate app under Cloud server once it is switched on. Set as sensitive.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Only for a self-hosted SMSGate server; the default is the free public relay.
SMSGATE_URL=
# A public deployment refuses mock SMS (it shows codes on screen) unless this is "true".
ALLOW_MOCK_SMS_IN_PRODUCTION=false
# ID + selfie checks. Only "mock" exists today (photos checked on-device, never stored,
# every application reviewed by staff). A real vendor (Sumsub, Veriff, Persona) plugs in here.
KYC_PROVIDER=mock
ALLOW_MOCK_KYC_IN_PRODUCTION=false

# --- Alerts on Viber and Messenger ---------------------------------------------
# "auto" uses a channel's real API when all its keys below are set, otherwise test mode
# (messages land in /dev/outbox). "mock" forces test mode for both.
CHANNELS_MODE=auto
# Viber bot (partners.viber.com): token, the bot's chat URI, and the sender name shown.
VIBER_BOT_TOKEN=
VIBER_BOT_URI=
VIBER_SENDER_NAME=Luxx4less
# Messenger: a Facebook Page and a Meta app with pages_messaging. Meta allows messages only
# within 24 hours of the person's last message to the Page; outside that, alerts go by email.
MESSENGER_PAGE_TOKEN=
MESSENGER_APP_SECRET=
# Any random string; enter the same one when setting up the webhook in the Meta app.
MESSENGER_VERIFY_TOKEN=
# The Page's username, for m.me links.
MESSENGER_PAGE_USERNAME=
MESSENGER_GRAPH_VERSION=v23.0

# --- Face re-verification (after ID is verified) ------------------------------------
# Asked before trading on each new sign-in, before trades of PHP 100,000+ and before payout
# changes. "mock" checks a live person follows the prompts but can't tell whose face it is;
# a vendor (identity vendor re-verification or AWS Rekognition Face Liveness) plugs in here.
FACE_PROVIDER=mock
ALLOW_MOCK_FACE_IN_PRODUCTION=false
